{
  "name": "dachvpn",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/dashboard && bun run dev",
    "build": "cd apps/dashboard && bun run build",
    "typecheck": "bun run typecheck:shared && bun run typecheck:crypto && bun run typecheck:dashboard",
    "typecheck:shared": "cd packages/shared && bunx tsc -p tsconfig.json --noEmit",
    "typecheck:crypto": "cd packages/crypto && bunx tsc -p tsconfig.json --noEmit",
    "typecheck:dashboard": "cd apps/dashboard && bunx tsc -p tsconfig.json --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "check:unit-count": "node scripts/check-unit-count.mjs",
    "check": "bun run check:docs && bun run mail:check && bun run typecheck",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:links": "node scripts/check-docs-links.mjs",
    "check:render": "node scripts/check-dashboard-render.mjs",
    "check:render:dry": "node scripts/check-dashboard-render.mjs dry",
    "mail:render": "bun scripts/render-mail-templates.mjs",
    "mail:check": "bun scripts/render-mail-templates.mjs --check",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:db": "node scripts/setup-db-url.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "test:stripe": "node scripts/stripe-smoke.mjs",
    "verify:angebot": "node scripts/verify-angebot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ipam": "node scripts/ipam-loadtest.mjs",
    "test:registration": "node scripts/registration-integration.mjs",
    "test:rls": "node scripts/rls-test.mjs",
    "test:subscription": "node scripts/subscription-sync-test.mjs",
    "test:tenants": "node scripts/tenant-brand-test.mjs",
    "test:entitlement": "node scripts/entitlement-test.mjs",
    "test:errors": "bun scripts/error-mapping-test.mjs",
    "test:stub": "node scripts/stub-contract-test.mjs",
    "test:routes": "bun scripts/device-routes-http-test.mjs",
    "test:revoke": "bun scripts/revoke-route-http-test.mjs",
    "test:webhook": "bun scripts/stripe-webhook-route-http-test.mjs",
    "test:admin": "bun scripts/admin-metrics-route-http-test.mjs",
    "test:billing": "bun scripts/stripe-billing-routes-http-test.mjs",
    "test:http": "node scripts/run-http-suites.mjs",
    "test:auth-route": "node scripts/run-auth-route.mjs",
    "test:db": "node scripts/run-db-suites.mjs"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@embedded-postgres/linux-x64"
  ]
}
