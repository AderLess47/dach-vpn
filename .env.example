# ============================================================================
# DACH VPN — Beispiel-Konfiguration (Namen only). Werte niemals committen.
# Kopieren nach .env (lokal) bzw. als Projekt-Secret hinterlegen.
# ============================================================================

# --- Next.js / Browser (öffentlich, kein Geheimnis) -------------------------
# Anzeigename in Metadata, UI und Dateiname der WireGuard-Config.
# Leer = Default aus packages/shared/src/brand.ts ("HubGuard").
NEXT_PUBLIC_APP_NAME=HubGuard
# Öffentliche Basis-URL für Checkout-Rücksprünge (Portal/Checkout)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Curve25519 Public Key des ersten VPN-Knotens (für Config-Preview im Browser)
NEXT_PUBLIC_WG_SERVER_PUBLIC_KEY=
NEXT_PUBLIC_WG_ENDPOINT=

# --- Supabase (serverseitig, geheim) ---------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gerätelimit pro Konto (serverseitig durchgesetzt)
MAX_DEVICES_PER_USER=5

# --- Stripe (geheim) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PIHOLE=

# --- Administration ---------------------------------------------------------
# Kommaseparierte Supabase-User-IDs mit Zugriff auf /api/admin/metrics
ADMIN_USER_IDS=

# --- WireGuard-Knoten (serverseitig) ---------------------------------------
# Knoten, dem neue Geräte zugewiesen werden (IP-Pool-Vergabe)
DEFAULT_NODE_ID=
WG_SERVER_ENDPOINT=
WG_SERVER_PUBLIC_KEY=
WG_DNS_FILTERED=10.9.0.1
WG_DNS_PLAIN=1.1.1.1

# --- Pull-Agent (M2) --------------------------------------------------------
NODE_ID=
AGENT_API_KEY=
AGENT_POLL_INTERVAL_SECONDS=30

# --- Lokaler IPAM-Test (nur Entwicklung/CI) --------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
